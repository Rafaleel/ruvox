# Copy to .env (never commit .env)

# LLM provider. Leave the key empty to run in no-LLM fallback mode (game modes 1-3).
ANTHROPIC_API_KEY=
RUVOX_LLM_MODEL=claude-sonnet-5-5

# Database (SQLite by default; swap for a Postgres URL later)
RUVOX_DATABASE_URL=sqlite:///./ruvox.db

# Frontend -> backend: Next.js only reads env files inside frontend/.
# Put this line in frontend/.env.local instead of here:
# NEXT_PUBLIC_API_URL=http://localhost:8000
