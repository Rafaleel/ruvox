{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruvox",
  "version": "0.1.0",
  "identifier": "dev.ruvox.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "make build-frontend prepare-dev-sidecar",
      "wait": true
    },
    "beforeBuildCommand": "make build-sidecar",
    "frontendDist": "splash"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "resources": {
      "binaries/runtime/ruvox-backend/": "sidecar/"
    },
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "Aprenda russo, do alfabeto às músicas.",
    "longDescription": "Ruvox ensina russo a falantes de português do Brasil, começando pelo alfabeto cirílico, com exercícios gerados por IA e vocabulário das suas músicas.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
